{
    "compilerOptions": {
        "outDir": "./dist",
        "module": "ESNext",
        "target": "ES2022",
        "moduleResolution": "node",
        "sourceMap": true,
        "baseUrl": "./src",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": false,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
